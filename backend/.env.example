# PixelForge 配置样例。复制成 .env 后按需修改（.env 不入库）。
# 所有值都可以用同名环境变量覆盖。

# --- adb ---------------------------------------------------------------------
# 强烈建议指向 vendor 里锁定版本的二进制，而不是 $PATH 里的那个：
# 机器上存在两个不同版本的 adb 会互相 kill 对方的 server。
PIXELFORGE_ADB_EXECUTABLE=adb

# 私有 adb server 端口。故意不用 5037 —— 那个是机器级单例，
# 同事开一次 Android Studio 就能掐断你所有设备会话。
PIXELFORGE_ADB_SERVER_PORT=5038
PIXELFORGE_ADB_TIMEOUT_S=15.0

# --- 设备来源 ---------------------------------------------------------------
# 默认 local，直接读取本机私有 adb server。使用 DeviceFarmer/STF v3.7.9 时
# 改成 devicefarmer；Token 只放环境变量/.env，不会返回给浏览器。
PIXELFORGE_DEVICE_PROVIDER=local
# PIXELFORGE_DEVICEFARMER_URL=https://devices.example.com
# PIXELFORGE_DEVICEFARMER_ACCESS_TOKEN=replace-with-minimal-api-token
PIXELFORGE_DEVICEFARMER_POLL_INTERVAL_S=3.0
PIXELFORGE_DEVICEFARMER_VERIFY_SSL=true

# --- 存储 --------------------------------------------------------------------
# 项目定义、脚本、模板、截图都落在这里。默认 backend/.pixelforge（已被 gitignore）。
# PIXELFORGE_DATA_DIR=~/.pixelforge

# 框选 PNG 默认保存到 PixelForge 项目根目录；如需固定到别处可在这里覆盖。
# 页面上的“选择目录”则使用浏览器系统目录选择器，并记住该选择。
# PIXELFORGE_ASSET_DIR=~/Desktop/PixelForgeAssets

# --- 租约 --------------------------------------------------------------------
# 设备独占的 TTL。前端按 TTL/3 心跳，所以丢一次请求不会掉租约。
PIXELFORGE_LEASE_TTL_S=30.0

# --- 插件 --------------------------------------------------------------------
# 业务专有的导出格式放在这里，不进核心。见 examples/exporters/。
# 这些文件会被当作 Python 导入执行，所以它们和源码一样敏感。
# PIXELFORGE_EXPORTER_PLUGINS=["/path/to/my-plugins"]

# --- 服务 --------------------------------------------------------------------
PIXELFORGE_HOST=127.0.0.1
PIXELFORGE_PORT=8420
PIXELFORGE_LOG_LEVEL=INFO

# 前端跑在同源（后端直接 mount），只有单独起 dev server 时才需要放行来源。
PIXELFORGE_CORS_ORIGINS=["http://localhost:5173"]

# 前端目录。留空则自动探测；wheel 安装且想挂 UI 时需要显式指定。
# PIXELFORGE_FRONTEND_DIR=/path/to/frontend
